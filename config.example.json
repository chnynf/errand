{
    "models": {
        "gemini-flash": {
            "provider": "gemini",
            "litellm_model": "gemini/gemini-3-flash-preview",
            "native_tools": true,
            "pricing": {"input": 0.30, "output": 2.50, "cache_read": 0.075}
        },
        "gemini-3.5-flash": {
            "provider": "gemini",
            "litellm_model": "gemini/gemini-3.5-flash",
            "native_tools": true,
            "pricing": {"input": 0.30, "output": 2.50, "cache_read": 0.075}
        },
        "deepseek-chat": {
            "provider": "deepseek",
            "litellm_model": "deepseek/deepseek-chat",
            "native_tools": true,
            "pricing": {"input": 0.28, "output": 0.42, "cache_read": 0.028}
        },
        "openai-compatible-example": {
            "provider": "example-provider",
            "litellm_model": "openai/provider/model-name",
            "api_base": "https://example.com/v1",
            "api_key_env": "EXAMPLE_PROVIDER_API_KEY",
            "native_tools": true,
            "pricing": {"input": 0.0, "output": 0.0, "cache_read": 0.0}
        },
        "siliconflow-deepseek-v4-flash": {
            "provider": "siliconflow",
            "litellm_model": "openai/deepseek-ai/DeepSeek-V4-Flash",
            "api_base": "https://api.siliconflow.com/v1",
            "api_key_env": "SILICONFLOW_API_KEY",
            "native_tools": true,
            "extra_body": {
                "enable_thinking": false
            },
            "pricing": {"input": 0.14, "output": 0.28, "cache_read": 0.0028}
        },
        "siliconflow-deepseek-v4-pro": {
            "provider": "siliconflow",
            "litellm_model": "openai/deepseek-ai/DeepSeek-V4-Pro",
            "api_base": "https://api.siliconflow.com/v1",
            "api_key_env": "SILICONFLOW_API_KEY",
            "native_tools": true,
            "extra_body": {
                "enable_thinking": false
            },
            "pricing": {"input": 0.28, "output": 1.10, "cache_read": 0.028}
        }
    },

    "model_strategy": [
        "gemini-3.5-flash",
        "gemini-flash",
        "siliconflow-deepseek-v4-flash",
        "siliconflow-deepseek-v4-pro",
        "deepseek-chat"
    ],

    "interfaces": {
        "discord": {
            "enabled": true
        },
        "cli": {
            "enabled": false
        },
        "wechat": {
            "enabled": false
        }
    },

    "scheduler": {
        "enabled": true,
        "poll_seconds": 10
    },

    "shared_soul": "~/my-kb/SOUL.md",
    "shared_notes_index": "~/my-kb/notes/INDEX.md",
    "agent_profile": "~/my-kb/generalist/INDEX.md",

    "default_agent": "generalist",
    "agents": {
        "generalist": {
            "description": "Personal generalist orchestrator grounded in the shared KB.",
            "shared_soul": "~/my-kb/SOUL.md",
            "agent_profile": "~/my-kb/generalist/INDEX.md",
            "model_strategy": [
                "gemini-3.5-flash",
                "gemini-flash",
                "siliconflow-deepseek-v4-flash",
                "siliconflow-deepseek-v4-pro",
                "deepseek-chat"
            ],
            "can_delegate": [
                "analyst",
                "cursor",
                "claude"
            ]
        },
        "analyst": {
            "description": "Specialist agent for data analysis and research tasks.",
            "shared_soul": "~/my-kb/SOUL.md",
            "agent_profile": "~/my-kb/analyst/INDEX.md",
            "model_strategy": [
                "gemini-3.5-flash",
                "gemini-flash",
                "siliconflow-deepseek-v4-flash"
            ],
            "can_delegate": [],
            "reasoning_effort": "high"
        }
    },

    "external_agents": {
        "cursor": {
            "description": "Cursor CLI-backed coding agent.",
            "command": [
                "cursor-agent",
                "--print",
                "--trust"
            ],
            "prompt_mode": "stdin",
            "timeout_seconds": 900,
            "max_output_chars": 20000
        },
        "claude": {
            "description": "Claude CLI-backed coding and reasoning agent.",
            "command": [
                "claude",
                "--output-format",
                "stream-json",
                "--input-format",
                "stream-json",
                "--verbose",
                "--permission-prompt-tool",
                "stdio",
                "--settings",
                "{\"alwaysThinkingEnabled\":false}"
            ],
            "prompt_mode": "stream_json",
            "timeout_seconds": 900,
            "max_output_chars": 20000
        }
    },

    "file_access": {
        "default_scope": "kb",
        "scopes": {
            "kb": {
                "roots": ["~/my-kb"],
                "read":   true,
                "list":   true,
                "write":  "ask",
                "append": "ask",
                "edit":   "ask",
                "delete": "ask"
            },
            "notes": {
                "roots": ["~/my-kb/notes"],
                "read":   true,
                "list":   true,
                "write":  "ask",
                "append": true,
                "edit":   "ask",
                "delete": "ask"
            },
            "workspace": {
                "roots": ["~/my-project"],
                "read":   true,
                "list":   true,
                "write":  "ask",
                "append": true,
                "edit":   "ask",
                "delete": "ask"
            }
        }
    },

    "sessions": {
        "idle_boundary_hours": 24
    },

    "retry": {
        "base_delay_seconds": 2
    }
}
