# Copy this file to .env and fill in your values.
# .env is git-ignored and will never be committed.

# --- LLM API keys (add only the providers you use) ---
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=

# --- Interfaces ---
DISCORD_TOKEN=          # required if discord interface is enabled

# --- Tools (optional, only if you use these tools) ---
NOTION_TOKEN=
EMAIL_ADDRESS=
EMAIL_PASSWORD=         # for Gmail: use an App Password, not your account password
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# --- Agent identity (shown to external delegated agents) ---
PAW_USER_NAME=
PAW_USER_EMAIL=
